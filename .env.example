# Alexa+ Streamable HTTP MCP Server Configuration
ALEXA_MCP_HOST=0.0.0.0
ALEXA_MCP_PORT=8092
ALEXA_SKILL_ID=amzn1.ask.skill.axisos-sovereign-outpost

# AWS Builder Mini-Challenge (Amazon Bedrock AgentCore Integration)
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_AGENT_ID=AXISOS-OUTPOST-AGENT

# AxisOS Sovereign Triad Endpoints (Local Loopback or Cloud Run Outpost)
AXISOS_ZERO_CORE_URL=http://127.0.0.1:8081
AXISOS_AGENT_LITE_URL=http://127.0.0.1:8080
AXISOS_AXIS_AGENT_URL=http://127.0.0.1:8082
AXISOS_ZERO_COMMS_URL=http://127.0.0.1:8085
AXISOS_CLOUD_OUTPOST_URL=https://axisos-sovereign-triad-4zye7tn3qq-uw.a.run.app

# Node 001 (Mayor) RP2350 Pico 2 W Dual-Homed Mesh
NODE001_MESH_IP=10.10.0.35
NODE001_LAN_IP=192.168.1.35
NODE001_UDP_PORT=50000
